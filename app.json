{
  "expo": {
    "name": "mingo-app",
    "slug": "mingo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mingoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
